{
  "name": "voicepath",
  "version": "0.1.0",
  "description": "Low-latency voice routing for agent apps — picks best TTS provider, falls back gracefully, maintains voice continuity",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node demo/latency-fallback.mjs",
    "validate": "bash scripts/validate.sh",
    "smoke": "node demo/latency-fallback.mjs \"Hello\"",
    "package:smoke": "npm pack --dry-run",
    "check": "node scripts/check.mjs",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "voice",
    "tts",
    "text-to-speech",
    "latency",
    "fallback",
    "agent",
    "routing",
    "elevenlabs",
    "openai",
    "continuity"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/voicepath.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/voicepath/issues"
  },
  "homepage": "https://github.com/rogerchappel/voicepath#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
