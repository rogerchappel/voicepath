{
  "name": "@voicepath/core",
  "version": "0.1.0",
  "description": "Local-first low-latency voice routing SDK for agent apps.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "demo",
    "examples",
    "docs",
    "README.md",
    "SAFETY.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node src/cli.js demo",
    "validate": "bash scripts/validate.sh"
  },
  "keywords": [
    "voice",
    "tts",
    "speech",
    "voice-agents",
    "agent-ui",
    "fallback",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "bin": {
    "voicepath": "./src/cli.js"
  },
  "homepage": "https://github.com/rogerchappel/voicepath#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rogerchappel/voicepath.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/voicepath/issues"
  },
  "sideEffects": false
}
